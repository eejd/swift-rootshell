// AppTests.xcconfig - Logic-only unit tests for pure app model code.
// No test host: the target compiles the sources it lists directly.
#include "Identity.xcconfig"
CODE_SIGN_STYLE = Automatic
CURRENT_PROJECT_VERSION = 1
GENERATE_INFOPLIST_FILE = YES
IPHONEOS_DEPLOYMENT_TARGET = 18.0
MARKETING_VERSION = 1.0
PRODUCT_BUNDLE_IDENTIFIER = $(ROOTSHELL_ORG_IDENTIFIER).apptests
PRODUCT_NAME = $(TARGET_NAME)
SDKROOT = iphoneos
STRING_CATALOG_GENERATE_SYMBOLS = NO
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = YES
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_EMIT_LOC_STRINGS = NO
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_VERSION = 5.0
// Project-level configs inject the app's bridging header and linker flags.
SWIFT_OBJC_BRIDGING_HEADER =
OTHER_LDFLAGS =
HEADER_SEARCH_PATHS =
